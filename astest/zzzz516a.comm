from code_aster.Commands import *
from code_aster.MacroCommands.defi_repere_ops import TransformToNaut
from code_aster import CA

DEBUT(CODE="OUI", DEBUG=_F(SDVERI="OUI"))

test = CA.TestCase()

# Unit test: transform euler to nautique
euler = TransformToNaut.eulnau([0, 0, 0])
test.assertArrayEqual(euler, [0, 0, 0])

euler = TransformToNaut.eulnau([90, 0, 0])
test.assertArrayEqual(euler, [90, 0, 0])

euler = TransformToNaut.eulnau([0, 90, 0])
test.assertArrayEqual(euler, [0, 0, 90])

euler = TransformToNaut.eulnau([0, 0, 90])
test.assertArrayEqual(euler, [90, 0, 0])

euler = TransformToNaut.eulnau([90, 90, 0])
test.assertArrayEqual(euler, [90, 0, 90])

euler = TransformToNaut.eulnau([0, 90, 90])
test.assertArrayEqual(euler, [45, 270, 45])

euler = TransformToNaut.eulnau([90, 0, 90])
test.assertArrayEqual(euler, [180, 0, 0])

euler = TransformToNaut.eulnau([90, 90, 90])
test.assertArrayEqual(euler, [135, 270, 45])

test.printSummary()

# Define geometry
cube = CA.Mesh.buildCube(refine=0)
cube = DEFI_GROUP(
    reuse=cube, CREA_GROUP_MA=_F(NOM="TOUT", TOUT="OUI", TYPE_MAILLE="3D"), MAILLAGE=cube
)

# Define model
model = AFFE_MODELE(
    MAILLAGE=cube, AFFE=_F(GROUP_MA="TOUT", PHENOMENE="MECANIQUE", MODELISATION="3D")
)

# Create coordinate system
chamorie = DEFI_REPERE(
    MODELE=model,
    DEFI=(
        _F(GROUP_MA="TOUT", SYST_COOR="CARTESIEN", ANGL_NAUT=(0, 0, 0)),
        _F(GROUP_MA="TOUT", SYST_COOR="CARTESIEN", ANGL_NAUT=(90, 45, 30)),
    ),
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="ALPHA",
        TYPE_TEST="MIN",
        VALE_CALC=90.0,
    )
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="BETA",
        TYPE_TEST="MIN",
        VALE_CALC=45.0,
    )
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="KAPPA",
        TYPE_TEST="MIN",
        VALE_CALC=30.0,
    )
)

chamorie = DEFI_REPERE(
    MODELE=model,
    DEFI=(
        _F(GROUP_MA="TOUT", SYST_COOR="CARTESIEN", ANGL_NAUT=(0, 0, 0)),
        _F(GROUP_MA="TOUT", SYST_COOR="CARTESIEN", ANGL_EULER=(0, 90, 90)),
    ),
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="ALPHA",
        TYPE_TEST="MIN",
        VALE_CALC=45,
    )
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="BETA",
        TYPE_TEST="MIN",
        VALE_CALC=270,
    )
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="KAPPA",
        TYPE_TEST="MIN",
        VALE_CALC=45,
    )
)

# Unit test: transform cylindrique to nautique
orig = [0, 0, 0]
point = [0.5, 0.5, 0.5]
cyl = TransformToNaut.cylnau(point, orig, [0, 0])
test.assertArrayEqual(cyl, [0, 0, 315])

cyl = TransformToNaut.cylnau(point, orig, [90, 0])
test.assertArrayEqual(cyl, [90, 0, 45])

cyl = TransformToNaut.cylnau(point, orig, [90, 90])
test.assertArrayEqual(cyl, [90, 90, 45])

cyl = TransformToNaut.cylnau(point, orig, [45, 54.7356103])
test.assertArrayEqual(cyl, [45, 54.7356103, 360])

test.printSummary()

chamorie = DEFI_REPERE(
    MODELE=model,
    DEFI=(
        _F(GROUP_MA="TOUT", SYST_COOR="CARTESIEN", ANGL_NAUT=(0, 0, 0)),
        _F(GROUP_MA="TOUT", SYST_COOR="CYLINDRIQUE", ANGL_AXE=(0, 0), ORIG_AXE=orig),
    ),
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="KAPPA",
        TYPE_TEST="MIN",
        VALE_CALC=315.0,
    )
)


chamorie = DEFI_REPERE(
    MODELE=model,
    DEFI=(
        _F(GROUP_MA="TOUT", SYST_COOR="CARTESIEN", ANGL_NAUT=(0, 0, 0)),
        _F(GROUP_MA="TOUT", SYST_COOR="CYLINDRIQUE", ANGL_AXE=(90, 0), ORIG_AXE=orig),
    ),
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="ALPHA",
        TYPE_TEST="MIN",
        VALE_CALC=90.0,
    )
)

TEST_RESU(
    CHAM_ELEM=_F(
        CHAM_GD=chamorie,
        CRITERE="ABSOLU",
        GROUP_MA="TOUT",
        NOM_CMP="KAPPA",
        TYPE_TEST="MIN",
        VALE_CALC=45.0,
    )
)


FIN()

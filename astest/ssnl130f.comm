DEBUT(CODE="OUI")

mail = LIRE_MAILLAGE(FORMAT="MED")

longueur = 0.1
mail = CREA_GRILLE(
    MAILLAGE=mail, GROUP_MA="DALLE", DISTANCE=longueur, COOR_CENTRE=(0.5, 1.0, -longueur / 2)
)

# IMPR_RESU(RESU=_F(MAILLAGE=mail))

model = AFFE_MODELE(
    MAILLAGE=mail,
    AFFE=(
        _F(GROUP_MA="DALLE", PHENOMENE="MECANIQUE", MODELISATION="DKT"),
        _F(
            GROUP_MA=(
                "X_RESSORT",
                "Y_RESSORT",
                "Z_RESSORT",
                "RX_RESSORT",
                "RY_RESSORT",
                "X_CENTRE",
                "Y_CENTRE",
                "Z_CENTRE",
                "RX_CENTRE",
                "RY_CENTRE",
            ),
            PHENOMENE="MECANIQUE",
            MODELISATION="DIS_TR",
        ),
    ),
)

acier = DEFI_MATERIAU(ELAS=_F(E=200000000000.0, NU=0.3))

mater = AFFE_MATERIAU(MAILLAGE=mail, AFFE=(_F(GROUP_MA="DALLE", MATER=acier),))

K = 1e8
K0 = 1e-3
carelem = AFFE_CARA_ELEM(
    INFO=1,
    MODELE=model,
    COQUE=_F(GROUP_MA="DALLE", EPAIS=0.3, COQUE_NCOU=1),
    RIGI_GRILLE=_F(
        GROUP_MA="DALLE",
        GROUP_MA_SEG2=("X_RESSORT", "Y_RESSORT", "Z_RESSORT", "RX_RESSORT", "RY_RESSORT"),
        VALE=(K, K, K, K, K),
        GROUP_NO_CENTRE=("X_CENTRE", "Y_CENTRE", "Z_CENTRE", "RX_CENTRE", "RY_CENTRE"),
        METHODE="UNIFORME",
    ),
    DISCRET=_F(
        GROUP_MA=("X_CENTRE", "Y_CENTRE", "Z_CENTRE", "RX_CENTRE", "RY_CENTRE"),
        CARA="K_TR_D_N",
        VALE=(K0, K0, K0, K0, K0, K0),
    ),
)

BLOC = AFFE_CHAR_MECA(
    MODELE=model,
    LIAISON_SOLIDE=(
        _F(GROUP_NO=("RX_CENTRE", "RX_RESSORT")),
        _F(GROUP_NO=("RY_CENTRE", "RY_RESSORT")),
        _F(GROUP_NO=("X_CENTRE", "X_RESSORT")),
        _F(GROUP_NO=("Y_CENTRE", "Y_RESSORT")),
        _F(GROUP_NO=("Z_CENTRE", "Z_RESSORT")),
    ),
    DDL_IMPO=(
        _F(GROUP_NO="X_CENTRE", DX=0, DY=0, DZ=0, DRX=0, DRY=0, DRZ=0),
        _F(GROUP_NO="Y_CENTRE", DX=0, DY=0, DZ=0, DRX=0, DRY=0, DRZ=0),
        _F(GROUP_NO="Z_CENTRE", DX=0, DY=0, DZ=0, DRZ=0),
        _F(GROUP_NO="RX_CENTRE", DX=0, DY=0, DRX=0, DRZ=0),
        _F(GROUP_NO="RY_CENTRE", DX=0, DY=0, DRY=0, DRZ=0),
    ),
)

CHARGE_XYZ = AFFE_CHAR_MECA(MODELE=model, FORCE_NODALE=_F(GROUP_NO="PCDG", FX=K, FY=K, FZ=K))

CHARGE_RX = AFFE_CHAR_MECA(MODELE=model, FORCE_NODALE=_F(GROUP_NO="PCDG", MX=K))

CHARGE_RY = AFFE_CHAR_MECA(MODELE=model, FORCE_NODALE=_F(GROUP_NO="PCDG", MY=K))

resu_xyz = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=mater,
    CARA_ELEM=carelem,
    SOLVEUR=_F(NPREC=9),
    EXCIT=(_F(CHARGE=BLOC), _F(CHARGE=CHARGE_XYZ)),
)

resu_rx = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=mater,
    CARA_ELEM=carelem,
    SOLVEUR=_F(NPREC=9),
    EXCIT=(_F(CHARGE=BLOC), _F(CHARGE=CHARGE_RX)),
)

resu_ry = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=mater,
    CARA_ELEM=carelem,
    SOLVEUR=_F(NPREC=9),
    EXCIT=(_F(CHARGE=BLOC), _F(CHARGE=CHARGE_RY)),
)

TEST_RESU(
    RESU=(
        _F(
            GROUP_NO="PT01",
            INST=0.0,
            REFERENCE="ANALYTIQUE",
            RESULTAT=resu_xyz,
            NOM_CHAM="DEPL",
            NOM_CMP="DX",
            VALE_CALC=0.9988040922767338,
            VALE_REFE=1.0,

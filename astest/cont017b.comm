## ------------------------------------
#   PARAMETERS
## ------------------------------------
# - Pairing
pairing_algo = "NEWTON"
# - Mesh parameters
use_quad = True
refine_mesh = False
refine_factor = 1

# - Physical parameters
young = 1.0
coef = young
use_friction = False
coef_coulomb = 0.1

# - Loadings parameters
fac = 1.0  # 0.86

TZ = 2.0
TX = 10.0
tfin = fac * TX
nsteps_tx = 5

dz = 3.0e-2
dx = 3.0e-1

# - Convergence parameters
resi_glob_rela = 1e-6
iter_glob_maxi = 50

DEBUT(CODE="OUI", ERREUR=_F(ERREUR_F="ABORT"))

ma = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

FIN()

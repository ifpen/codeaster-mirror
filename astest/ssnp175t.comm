DEBUT(CODE="OUI", DEBUG=_F(SDVERI="OUI"), INFO=1)

Mail0 = LIRE_MAILLAGE(UNITE=20, FORMAT="MED")

Mail1 = Mail0.convertToBiQuadratic()

Mail = CREA_MAILLAGE(MAILLAGE=Mail1, MODI_HHO=_F(GROUP_MA="Haut"))


Mail = MODI_MAILLAGE(
    reuse=Mail,
    MAILLAGE=Mail,
    ORIE_PEAU=_F(GROUP_MA_PEAU=("LIAISON_Haut", "LIAISON_Bas", "Encast", "Pres")),
)

MODI = AFFE_MODELE(
    MAILLAGE=Mail,
    AFFE=(
        _F(
            GROUP_MA=("Haut", "LIAISON_Haut", "Pres", "Symx_Haut", "Symy_Haut"),
            PHENOMENE="MECANIQUE",
            MODELISATION="3D_HHO",
            FORMULATION="QUADRATIQUE",
        ),
        _F(
            GROUP_MA=("Bas", "LIAISON_Bas", "Encast", "Symx_Bas", "Symy_Bas"),
            PHENOMENE="MECANIQUE",
            MODELISATION="3D",
        ),
    ),
)

E = 2000.0

mat1 = DEFI_MATERIAU(ELAS=_F(E=E, NU=0.3))

AFFE = AFFE_MATERIAU(MAILLAGE=Mail, MODELE=MODI, AFFE=_F(TOUT="OUI", MATER=mat1))

RACCORD = AFFE_CHAR_MECA(
    MODELE=MODI,
    INFO=1,
    LIAISON_MASSIF=_F(
        GROUP_MA_ESCL="LIAISON_Bas", GROUP_MA_MAIT="LIAISON_Haut", METHODE="NITSCHE", COEF_PENA=E
    ),
)

CINE_HHO = AFFE_CHAR_CINE(
    MODELE=MODI,
    MECA_IMPO=(
        _F(GROUP_MA="Symx_Bas", DX=0),
        _F(GROUP_MA="Symy_Bas", DY=0),
        _F(GROUP_MA="Encast", DZ=0),
    ),
)

CINE_FEM = AFFE_CHAR_CINE(
    MODELE=MODI, MECA_IMPO=(_F(GROUP_MA="Symx_Haut", DX=0), _F(GROUP_MA="Symy_Haut", DY=0))
)

CHAR_PRES = AFFE_CHAR_MECA(MODELE=MODI, PRES_REP=_F(GROUP_MA="Pres", PRES=25))


RES = MECA_STATIQUE(
    INFO=1,
    MODELE=MODI,
    CHAM_MATER=AFFE,
    EXCIT=(_F(CHARGE=CINE_FEM), _F(CHARGE=CINE_HHO), _F(CHARGE=CHAR_PRES), _F(CHARGE=RACCORD)),
    INST=1.0,
)

RES = CALC_CHAMP(
    reuse=RES, RESULTAT=RES, CONTRAINTE=("SIEF_NOEU", "SIEF_ELNO", "SIGM_NOEU", "SIGM_ELNO")
)


TEST_RESU(
    RESU=(
        _F(
            INST=1.0,
            TYPE_TEST="MIN",
            RESULTAT=RES,
            REFERENCE="ANALYTIQUE",
            NOM_CHAM="SIEF_NOEU",
            LEGENDE="SIEF_NOEU",
            NOM_CMP="SIZZ",
            VALE_REFE=-25.0,
            VALE_CALC=-25.000000000005045,
            PRECISION=1e-12,
        ),
        _F(
            INST=1.0,
            TYPE_TEST="MAX",
            RESULTAT=RES,
            REFERENCE="ANALYTIQUE",
            NOM_CHAM="SIEF_NOEU",
            LEGENDE="SIEF_NOEU",
            NOM_CMP="SIZZ",
            VALE_REFE=-25.0,
            VALE_CALC=-25.000000000005045,
            PRECISION=1e-12,
        ),
        _F(
            INST=1.0,
            TYPE_TEST="MIN",
            RESULTAT=RES,
            REFERENCE="ANALYTIQUE",
            NOM_CHAM="SIGM_NOEU",
            LEGENDE="SIZZ",
            NOM_CMP="SIZZ",
            VALE_REFE=-25.0,
            VALE_CALC=-25.000000000005045,
            PRECISION=1e-12,
        ),
        _F(
            INST=1.0,
            TYPE_TEST="MAX",
            RESULTAT=RES,
            REFERENCE="ANALYTIQUE",
            NOM_CHAM="SIGM_NOEU",
            LEGENDE="SIZZ",
            NOM_CMP="SIZZ",
            VALE_REFE=-25.0,
            VALE_CALC=-25.000000000005045,
            PRECISION=1e-12,
        ),
        _F(
            INST=1.0,
            TYPE_TEST="MIN",
            RESULTAT=RES,
            REFERENCE="ANALYTIQUE",
            NOM_CHAM="SIGM_NOEU",
            LEGENDE="SIXY",
            NOM_CMP="SIXY",
            CRITERE="ABSOLU",
            ORDRE_GRANDEUR=1e-5,
            VALE_REFE=0.0,
            VALE_CALC=0.0,
        ),
        _F(
            INST=1.0,
            TYPE_TEST="MAX",
            RESULTAT=RES,
            REFERENCE="ANALYTIQUE",
            NOM_CHAM="SIGM_NOEU",
            LEGENDE="SIXY",
            NOM_CMP="SIXY",
            CRITERE="ABSOLU",
            ORDRE_GRANDEUR=1e-5,
            VALE_REFE=0.0,
            VALE_CALC=0.0,
        ),
    )
)

FIN()

fieldMaterMeca = AFFE_MATERIAU(
    MAILLAGE=mesh,
    AFFE=_F(TOUT="OUI", MATER=steelMeca),
    AFFE_VARC=(
        _F(TOUT="OUI", EVOL=TEMPE, NOM_VARC="M_REVENU", NOM_CHAM="META_ELNO"),
        _F(TOUT="OUI", EVOL=TEMPE, NOM_VARC="TEMP", NOM_CHAM="TEMP", VALE_REF=900),
    ),
)

modelMeca = AFFE_MODELE(
    MAILLAGE=mesh, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="AXIS")
)

CH_FO = AFFE_CHAR_MECA(
    MODELE=modelMeca,
    FORCE_CONTOUR=_F(GROUP_MA="M3", FY=1.0),
    DDL_IMPO=(_F(GROUP_NO="N4", DY=0.0), _F(GROUP_NO="N2", DY=0.0), _F(GROUP_NO="N5", DY=0.0)),
)

RAMPE = DEFI_FONCTION(
    NOM_PARA="INST",
    PROL_GAUCHE="LINEAIRE",
    PROL_DROITE="LINEAIRE",
    VALE=(0.0, 0.0, 100.0, 1500.0e6),
)

L_INST = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=(
        _F(JUSQU_A=24.0, NOMBRE=6),
        _F(JUSQU_A=40.0, NOMBRE=8),
        _F(JUSQU_A=90.0, NOMBRE=13),
    ),
)

DEFLISTM = DEFI_LIST_INST(DEFI_LIST=_F(LIST_INST=L_INST))

U = STAT_NON_LINE(
    MODELE=modelMeca,
    CHAM_MATER=fieldMaterMeca,
    EXCIT=_F(CHARGE=CH_FO, FONC_MULT=RAMPE),
    COMPORTEMENT=_F(RELATION="META_V_IL", RELATION_KIT=("ACIER_REVENU",)),
    INCREMENT=_F(LIST_INST=DEFLISTM, NUME_INST_FIN=27),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    CONVERGENCE=_F(RESI_GLOB_RELA=1.0e-8, ITER_GLOB_MAXI=40),
)

U = CALC_CHAMP(reuse=U, CONTRAINTE=("SIGM_ELNO"), VARI_INTERNE=("VARI_ELNO"), RESULTAT=U)


U = CALC_CHAMP(
    reuse=U, RESULTAT=U, DEFORMATION=("EPSI_ELNO", "EPVC_ELNO", "EPME_ELNO", "EPSP_ELNO")
)


CHVAR24 = CREA_CHAMP(

YOUNG = DEFI_CONSTANTE(VALE=200000.0e6)

NU = DEFI_CONSTANTE(VALE=0.3)

steelMeca = DEFI_MATERIAU(
    ELAS_META_FO=_F(
        E=YOUNG,
        NU=NU,
        F_ALPHA=ALP1,
        C_ALPHA=ALP2,
        PHASE_REFE="CHAUD",
        EPSF_EPSC_TREF=2.52e-3,
        F1_S_VP=F_S_VP,
        F2_S_VP=F_S_VP,
        F3_S_VP=F_S_VP,
        F4_S_VP=F_S_VP,
        F5_S_VP=F_S_VP,
        F6_S_VP=F_S_VP,
        C_S_VP=AUS2,
        TEMP_DEF_ALPHA=900.0,
        S_VP_MELANGE=FMEL,
    ),
    META_ECRO_LINE=_F(
        F1_D_SIGM_EPSI=F_D_SIGM_EPSI,
        F2_D_SIGM_EPSI=F_D_SIGM_EPSI,
        F3_D_SIGM_EPSI=F_D_SIGM_EPSI,
        F4_D_SIGM_EPSI=F_D_SIGM_EPSI,
        F5_D_SIGM_EPSI=F_D_SIGM_EPSI,
        F6_D_SIGM_EPSI=F_D_SIGM_EPSI,
        C_D_SIGM_EPSI=AUS1,
    ),
    META_VISC_FO=_F(
